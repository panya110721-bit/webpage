<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Portfolio</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    scroll-behavior:smooth;
}

body{
    font-family:"Noto Sans Thai",sans-serif;
    color:white;
    background:linear-gradient(to bottom,#6ec6ff,#2196f3,#1565c0);
    overflow-x:hidden;
}

/* เมนู */
nav{
    position:fixed;
    top:0;
    width:100%;
    background:rgba(0,0,0,.4);
    backdrop-filter:blur(10px);
    z-index:1000;
}

nav ul{
    display:flex;
    justify-content:center;
    list-style:none;
}

nav a{
    display:block;
    padding:20px;
    color:white;
    text-decoration:none;
    transition:.3s;
}

nav a:hover{
    background:#4fc3f7;
    transform:translateY(-3px);
}

/* เอฟเฟกเมาส์ */
.cursor{
    width:25px;
    height:25px;
    border-radius:50%;
    background:rgba(255,255,255,.5);
    position:fixed;
    pointer-events:none;
    transform:translate(-50%,-50%);
    z-index:9999;
    box-shadow:0 0 20px white;
}

/* แม่น้ำ */
.river{
    position:fixed;
    bottom:0;
    width:100%;
    height:200px;
    background:linear-gradient(
        rgba(0,180,255,.8),
        rgba(0,100,255,.9)
    );
    overflow:hidden;
}

/* ดอกบัว */
.lotus{
    position:absolute;
    bottom:50px;
    font-size:50px;
    animation:float 5s ease-in-out infinite;
}

.l1{left:10%;}
.l2{left:40%;}
.l3{left:75%;}

@keyframes float{
    50%{
        transform:translateY(-15px);
    }
}

/* ปลา */
.fish{
    position:absolute;
    font-size:40px;
    animation:swim 18s linear infinite;
}

@keyframes swim{
    from{
        left:-100px;
    }
    to{
        left:110%;
    }
}

/* section */
section{
    min-height:100vh;
    padding:120px 10%;
}

.card{
    background:rgba(255,255,255,.15);
    backdrop-filter:blur(15px);
    border-radius:20px;
    padding:30px;
    margin-top:30px;
    transition:.4s;
}

.card:hover{
    transform:translateY(-10px);
    box-shadow:0 0 30px rgba(255,255,255,.5);
}

.profile-img{
    width:220px;
    height:220px;
    border-radius:50%;
    object-fit:cover;
    border:5px solid white;
}

h1,h2{
    margin-bottom:20px;
}

.hobby-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
    gap:20px;
}

.hobby{
    padding:25px;
    text-align:center;
    background:rgba(255,255,255,.15);
    border-radius:15px;
    transition:.3s;
}

.hobby:hover{
    transform:scale(1.05);
    background:rgba(255,255,255,.3);
}

.contact a{
    display:block;
    color:white;
    margin:10px 0;
    text-decoration:none;
}
</style>
</head>
<body>

<audio autoplay loop>
    <source src="music.mp3" type="audio/mpeg">
</audio>

<div class="cursor"></div>

<nav>
<ul>
<li><a href="#profile">Profile</a></li>
<li><a href="#education">Education</a></li>
<li><a href="#hobby">Hobby</a></li>
<li><a href="#contact">Contact</a></li>
</ul>
</nav>

<section id="profile">
<h1>PROFILE</h1>

<div class="card">
<img src="profile.jpg" class="profile-img">

<h2>ข้อมูลส่วนตัว</h2>

<p><b>ชื่อจริง:</b> ใส่ชื่อจริง</p>
<p><b>ชื่อเล่น:</b> ใส่ชื่อเล่น</p>
<p><b>วันเกิด:</b> DD/MM/YYYY</p>
<p><b>อายุ:</b> XX ปี</p>
<p><b>ระดับชั้น:</b> ม.3</p>
<p><b>ห้อง:</b> 3/2</p>
<p><b>สิ่งที่ชอบ:</b> วิทยาศาสตร์ ธรรมชาติ</p>
<p><b>วิชาที่สนใจ:</b> ชีววิทยา</p>
<p><b>คติประจำใจ:</b> ความพยายามอยู่ที่ไหน ความสำเร็จอยู่ที่นั่น</p>
</div>
</section>

<section id="education">
<h1>EDUCATION</h1>

<div class="card">
<h2>อนุบาล</h2>
<p>โรงเรียน...</p>
</div>

<div class="card">
<h2>ประถมศึกษา</h2>
<p>โรงเรียน...</p>
</div>

<div class="card">
<h2>มัธยมศึกษา</h2>
<p>โรงเรียนจอมทอง</p>
</div>
</section>

<section id="hobby">
<h1>HOBBY</h1>

<div class="hobby-grid">

<div class="hobby">📚 อ่านหนังสือ</div>
<div class="hobby">🎵 ฟังเพลง</div>
<div class="hobby">🎮 เล่นเกม</div>
<div class="hobby">📷 ถ่ายภาพ</div>
<div class="hobby">🌱 ปลูกต้นไม้</div>
<div class="hobby">🎨 วาดรูป</div>

</div>
</section>

<section id="contact">
<h1>CONTACT</h1>

<div class="card contact">
<a href="#">📞 08x-xxx-xxxx</a>
<a href="#">📘 Facebook</a>
<a href="#">📷 Instagram</a>
<a href="#">✉️ example@gmail.com</a>
</div>
</section>

<div class="river">

<div class="lotus l1">🌸</div>
<div class="lotus l2">🌸</div>
<div class="lotus l3">🌸</div>

<div class="fish" style="top:30px;">🐟</div>
<div class="fish" style="top:100px;animation-delay:5s;">🐠</div>
<div class="fish" style="top:150px;animation-delay:10s;">🐡</div>

</div>

<script>
const cursor=document.querySelector(".cursor");

document.addEventListener("mousemove",e=>{
    cursor.style.left=e.clientX+"px";
    cursor.style.top=e.clientY+"px";
});

/* เสียงคลิก */
const clickSound=new Audio(
'https://www.soundjay.com/buttons/sounds/button-09.mp3'
);

document.querySelectorAll("a").forEach(btn=>{
    btn.addEventListener("click",()=>{
        clickSound.play();
    });
});
</script>

</body>
</html>
